{
  "name": "motionshelf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-catalog.mjs",
    "validate:release": "node scripts/validate-catalog.mjs --release",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build",
    "build:release": "npm run validate:release && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "lenis": "^1.3.27",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
